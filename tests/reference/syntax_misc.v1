// var inside nested blocks, empty function, getc() as a statement, putc as a value,
// nested array index, unary minus chains, nested calls
array a[4];
array b[4];
func noop() { }
func twice(x) { return x + x; }
func main() {
    var r;
    a[0] = 3; b[3] = 2; a[2] = 9;
    r = 0;
    while (r < 2) {
        var t;
        t = r * 10;
        r = r + 1;
        if (t) { var u; u = t + 1; putc(48 + u - 10); }
    }
    noop();
    getc();
    r = putc(66) + 1;
    putc(48 + r);
    putc(48 + a[b[3]] - 6);
    putc(48 + - -2 + -(-1));
    if (twice(twice(3)) == 12) { putc(89); }
    putc(10);
}
