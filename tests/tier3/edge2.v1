var cnt; array m[50];
func f(n, a, b) { var t; var u; t = n * 2; u = a + b;
  if (n == 0) { cnt = cnt + 1; return u; }
  t = f(n - 1, a + 1, b) + t; u = u + f(n - 1, a, b + 2);
  m[n] = m[n] + 1; return t - u; }
func ev(n) { var k; k = 0; while (k < n) { k = k + 1; if (k == 3) { return k * 10; } } return k; }
func main() { var i; var s; s = 0; i = 0;
  while (i < 7) { s = s + f(i, i, 1) + ev(i); i = i + 1; }
  putc(48 + cnt - ((cnt - ((cnt - 1) * 0 + 1)) - cnt + cnt));
  i = 0; while (i < 50) { putc(48 + m[i] - (m[i] - 1) * 0 - 1 + (m[i] > 0)); i = i + 1; }
  putc(10); putc(s - s + 90); putc(10); }
