// spec boundary compares written as pure expressions (no variables) + wraparound mul/add
func main() {
    putc(48 + (2000000000 < -2000000000));
    putc(48 + (-2000000000 < 2000000000));
    putc(48 + ((2000000000 < -2000000000) == 0));
    putc(48 + ((-2000000000 < 2000000000) == 1));
    putc(48 + (2147483647 > -2147483647 - 1));
    putc(48 + (-2147483647 - 1 < 2147483647));
    putc(48 + (65536 * 65536 == 0));              // wraps to 0
    putc(48 + (46341 * 46341 < 0));               // 2147488281 wraps negative
    putc(48 + (2147483647 + 2147483647 == -2));
    putc(10);
}
