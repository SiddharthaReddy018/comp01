// else { if } chains, while on nonzero (incl. negative) values, if on nonzero
func cls(x) {
    if (x < 0) { return 1; } else { if (x == 0) { return 2; } else { if (x < 10) { return 3; } else { return 4; } } }
}
func main() {
    var n; var k;
    putc(48 + cls(0 - 5)); putc(48 + cls(0)); putc(48 + cls(7)); putc(48 + cls(99)); putc(10);
    n = 0 - 3; k = 0;
    while (n) { k = k + 1; n = n + 1; }       // negative is truthy: 3 iterations
    putc(48 + k);
    if (0 - 1) { putc(89); } else { putc(78); }
    if (0) { putc(78); } else { putc(89); }
    if (2147483647) { putc(89); } else { putc(78); }
    n = 5; k = 0;
    while (n) { k = k + n; n = n - 1; }       // 15
    if (k == 15) { putc(89); } else { putc(78); }
    putc(10);
}
